<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dottype.Build" Version="0.3.0" />
    <None Remove="customer.json;orders.ndjson" />
    <dottype Include="customer.json" Options="--name Models.Customer" />
    <dottype Include="orders.ndjson" Options="--name Models.Order" />
    <Content Include="customer.json;orders.ndjson" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
